
    const dataDecals = CK.character && CK.character.data && CK.character.data.decals;
    const splatter = dataDecals && dataDecals.splatter;
    const record = splatter && splatter[mapping];
    if (!record || typeof record !== 'object') return { ok: false, reason: `No decal record at splatter mapping ${mapping}.` };

    return { ok: true, ordered, selectedLabel, sourceLayer, entry, mapping, record };
  }

  function resolveRenderedMatches(selected) {
    const CK = getCK();
    const modded = CK && CK.character && CK.character.display && CK.character.display.modded;
    const displayDecals = modded && modded.displayDecals;
    const meshes = CK && CK.character && CK.character.display && CK.character.display.meshes;
    if (!displayDecals || !meshes) return { ok: false, reason: 'Rendered decal structures unavailable.' };

    const matches = [];
    const seen = new Set();
    for (const [target, list] of Object.entries(displayDecals)) {
      if (!Array.isArray(list)) continue;
      for (let index = 0; index < list.length; index += 1) {
        const item = list[index];
        if (!item || item.sourceSlot !== 'splatter' || Number(item.sourceLayer) !== Number(selected.sourceLayer)) continue;
        const currentId = item.id != null ? Number(item.id) : (item.decal && item.decal.id != null ? Number(item.decal.id) : null);
        if (currentId != null && Number(selected.record.id) !== currentId) continue;

        const mesh = meshes[target];
        const colorDecals = mesh && mesh.bakeMaterials && mesh.bakeMaterials.colorDecals;
        const material = colorDecals && colorDecals[index];
        const uniforms = material && material.uniforms;
        const projectUniform = uniforms && uniforms.l0_project && uniforms.l0_project.value;
        const matrix = cloneElements(projectUniform);
        if (!matrix) continue;

        const key = `${target}:${index}`;
        if (seen.has(key)) continue;
        seen.add(key);
        matches.push({ target, index, item, mesh, material, uniforms, matrix });
      }
    }
    if (!matches.length) return { ok: false, reason: `No rendered material matches selected splatter mapping ${selected.mapping}.` };
    return { ok: true, matches };
  }

  function sharedProjectorWorldFrame(nativeLocator) {
    if (!nativeLocator || !nativeLocator.parent) return null;
    if (typeof nativeLocator.parent.updateMatrixWorld === 'function') nativeLocator.parent.updateMatrixWorld();
    return cloneElements(nativeLocator.parent.matrixWorld);
  }

  function summarizeProjector(matches, worldFrame, frameLabel) {
    if (!matches.length || !worldFrame) return { ok: false, reason: 'Projector summary prerequisites unavailable.' };
    const worldToCanonical = matches.map(match => invertMat4(match.matrix));
    if (worldToCanonical.some(v => !v)) return { ok: false, reason: 'l0_project inversion failed.' };

    const localCenters = worldToCanonical.map(inverse => normalizeHomogeneous(mat4MulVec4(inverse, [0, 0, 0, 1])));
    if (localCenters.some(v => !v)) return { ok: false, reason: 'Projector center reconstruction failed.' };
    const worldCenters = localCenters.map(point => normalizeHomogeneous(mat4MulVec4(worldFrame, point)));
    if (worldCenters.some(v => !v)) return { ok: false, reason: 'Projector center frame conversion failed.' };
    const center = [
      median(worldCenters.map(v => v[0])),
      median(worldCenters.map(v => v[1])),
      median(worldCenters.map(v => v[2]))
    ];
    const maxSpread = Math.max(...worldCenters.map(v => distance3(v, center)));
    return {
      ok: true,
      frameLabel,
      worldFrame,
      worldToCanonical,
      localCenters,
      worldCenters,
      center,
      maxSpread
    };
  }

  function getCameraInfo(CK) {
    const camera = CK && CK.orbitCamera && CK.orbitCamera.camera;
    if (!camera) return null;
    if (typeof camera.updateMatrixWorld === 'function') camera.updateMatrixWorld();
    if (typeof camera.updateProjectionMatrix === 'function') {
      try { camera.updateProjectionMatrix(); } catch (_) {}
    }
    const matrixWorld = cloneElements(camera.matrixWorld);
    const projectionMatrix = cloneElements(camera.projectionMatrix);
    const viewMatrix = matrixWorld && invertMat4(matrixWorld);
    let rect = null;
    try {
      const dom = CK.getDomElement && CK.getDomElement();
      const r = dom && dom.getBoundingClientRect ? dom.getBoundingClientRect() : null;
      if (r) rect = { left: r.left, top: r.top, width: r.width, height: r.height, right: r.right, bottom: r.bottom };
    } catch (_) {}
    if (!matrixWorld || !projectionMatrix || !viewMatrix || !rect || !rect.width || !rect.height) return null;
    return { camera, matrixWorld, projectionMatrix, viewMatrix, rect };
  }

  function worldToScreen(point, cameraInfo) {
    const view = mat4MulVec4(cameraInfo.viewMatrix, [point[0], point[1], point[2], 1]);
    const clip = mat4MulVec4(cameraInfo.projectionMatrix, view);
    if (!clip.every(Number.isFinite) || Math.abs(clip[3]) < 1e-10) return null;
    const ndcX = clip[0] / clip[3];
    const ndcY = clip[1] / clip[3];
    return {
      x: cameraInfo.rect.left + (ndcX + 1) * 0.5 * cameraInfo.rect.width,
      y: cameraInfo.rect.top + (1 - ndcY) * 0.5 * cameraInfo.rect.height,
      ndc: [ndcX, ndcY, clip[2] / clip[3]],
      clipW: clip[3],
      behind: clip[3] <= 0
    };
  }

  function findCanvasElements() {
    return Array.from(document.querySelectorAll('canvas')).filter(canvas => {
      const rect = canvas.getBoundingClientRect();
      return rect.width > 200 && rect.height > 150;
    });
  }

  function resolveProjectorVolumeAnchor(CK, projector) {
    const cameraInfo = getCameraInfo(CK);
    if (!cameraInfo) return { ok: false, reason: 'Camera matrices unavailable.' };
    const screen = worldToScreen(projector.center, cameraInfo);
    if (!screen || screen.behind) return { ok: false, reason: 'Stable projector center is behind camera.' };
    return {
      ok: true,
      method: 'projector.center',
      point: projector.center.slice(),
      screen,
      debug: {
        centerScreen: screen,
        frameLabel: projector.frameLabel,
        maxSpread: projector.maxSpread,
        canvasCount: findCanvasElements().length
      }
    };
  }

  function constructorName(value) {
    try { return value && value.constructor && value.constructor.name ? String(value.constructor.name) : ''; } catch (_) { return ''; }
  }

  function isNativeDecalTransformer(node) {
    if (!node || typeof node !== 'object') return false;
    if (node.name === 'kwCorrectedBoundDecalGizmoProxy') return false;
    const object = node.object;
    if (!object || object.name !== 'decalLocator') return false;
    if (typeof node.refresh !== 'function' || typeof node.setMode !== 'function' || typeof node.dispatchEvent !== 'function') return false;
    const listeners = node._listeners;
    return Boolean(listeners && Array.isArray(listeners.change) && listeners.change.some(fn => typeof fn === 'function') && Array.isArray(listeners['change-finished']) && listeners['change-finished'].some(fn => typeof fn === 'function'));
  }

  function findNativeDecalTransformers(scene) {
    const matches = [];
    if (!scene) return { matches, visited: 0, truncated: false };
    const queue = [scene];
    const seen = new Set();
    let visited = 0;
    while (queue.length && visited < MAX_SCENE_VISITS) {
      const node = queue.shift();
      if (!node || typeof node !== 'object' || seen.has(node)) continue;
      seen.add(node);
      visited += 1;
      if (isNativeDecalTransformer(node)) matches.push(node);
      const children = Array.isArray(node.children) ? node.children : [];
      for (const child of children) queue.push(child);
    }
    return { matches, visited, truncated: queue.length > 0 };
  }

  function getWorldTransform(object) {
    const RK = getRK();
    if (!object || !RK) throw new Error('World transform unavailable.');
    if (typeof object.updateMatrixWorld === 'function') object.updateMatrixWorld();
    const position = new RK.Vec3();
    const quaternion = new RK.Quaternion();
    const scale = new RK.Vec3();
    object.matrixWorld.decompose(position, quaternion, scale);
    return { position, quaternion, scale };
  }

  function markTransformDirty(object) {
    if (!object) return;
    if (typeof object.setMatrixNeedsUpdate === 'function') object.setMatrixNeedsUpdate(true);
    if (typeof object.updateMatrixWorld === 'function') object.updateMatrixWorld();
  }

  function resolveCurrent() {
    const CK = getCK();
    if (!CK) return { ok: false, reason: 'CK unavailable.' };
    if (!UW.RK || typeof UW.RK.Object3D !== 'function') return { ok: false, reason: 'RK.Object3D unavailable.' };
    if (!UW.EX || typeof UW.EX.Transformer !== 'function') return { ok: false, reason: 'EX.Transformer unavailable.' };
    if (!CK.scene || typeof CK.scene.add !== 'function') return { ok: false, reason: 'CK.scene unavailable.' };
    if (typeof CK.getDomElement !== 'function') return { ok: false, reason: 'CK.getDomElement unavailable.' };
    if (typeof CK.activeTweak !== 'function') return { ok: false, reason: 'CK.activeTweak unavailable.' };

    const selected = selectedSplatterInfo(CK);
    if (!selected.ok) return selected;
    if (selected.record.forceProjectedScript !== false) return { ok: false, reason: 'Selected decal must be Project OFF / bound.' };
    const rendered = resolveRenderedMatches(selected);
    if (!rendered.ok) return rendered;

    const nativeScan = findNativeDecalTransformers(CK.scene);
    if (nativeScan.matches.length === 0) return { ok: false, reason: 'Native decal gizmo not found. Turn HeroForge\'s decal gizmo ON.' };
    if (nativeScan.matches.length !== 1) return { ok: false, reason: `Ambiguous native decal gizmos: ${nativeScan.matches.length}.` };
    const nt = nativeScan.matches[0];
    const locator = nt.object;
    if (!locator || !locator.parent) return { ok: false, reason: 'Native decalLocator has no parent.' };

    const worldFrame = sharedProjectorWorldFrame(locator);
    if (!worldFrame) return { ok: false, reason: 'Native decalLocator parent world frame unavailable.' };
    const projector = summarizeProjector(rendered.matches, worldFrame, `native ${locator.parent.name || 'decalLocator parent'}`);
    if (!projector.ok) return projector;
    const footprint = resolveProjectorVolumeAnchor(CK, projector);
    if (!footprint.ok) return footprint;

    return {
      ok: true,
      CK,
      selected,
      rendered,
      projector,
      footprint,
      nativeTransformer: nt,
      nativeLocator: locator,
      nativeScan,
      locatorPosition: vec3Array(locator.position),
      locatorScale: vec3Array(locator.scale),
      locatorQuaternion: quatArray(locator.quaternion)
    };
  }

  function verifyLiveBinding() {
    if (!enabled || !activeBinding || !nativeTransformer || !nativeLocator) throw new Error('Corrected gizmo binding unavailable.');
    if (!nativeTransformer.parent || nativeTransformer.object !== nativeLocator || !nativeLocator.parent) throw new Error('Native decal gizmo was disabled, detached, or recreated.');
    const currentSelected = selectedSplatterInfo(getCK());
    if (!currentSelected.ok) throw new Error(currentSelected.reason);
    if (currentSelected.record.forceProjectedScript !== false) throw new Error('Selected decal is no longer Project OFF / bound.');
    if (currentSelected.mapping !== activeBinding.mapping || Number(currentSelected.record.id) !== Number(activeBinding.decalId)) throw new Error('Selected decal changed. Disable/re-enable.');
  }

  function dispatchNative(finalize) {
    markTransformDirty(nativeLocator);
    nativeTransformer.dispatchEvent({ type: finalize ? 'change-finished' : 'change', value: nativeLocator });
    lastForward = {
      mode,
      finalize,
      position: vec3Array(nativeLocator.position),
      scale: vec3Array(nativeLocator.scale),
      quaternion: quatArray(nativeLocator.quaternion),
      at: Date.now()
    };
  }

  function applyRawMove(raw, finalize = false) {
    verifyLiveBinding();
    if (!raw || raw.length < 3 || !raw.every(Number.isFinite)) throw new Error('Invalid bound Move h/v/d values.');

    const CK = getCK();
    const selected = selectedSplatterInfo(CK);
    if (!selected.ok) throw new Error(selected.reason);
    if (selected.mapping !== activeBinding.mapping || Number(selected.record.id) !== Number(activeBinding.decalId)) {
      throw new Error('Selected decal changed while corrected Move was active.');
    }

    const decals = CK.character && CK.character.data && CK.character.data.decals;
    const splatter = decals && decals.splatter;
    if (!decals || !splatter) throw new Error('Current decal state unavailable.');

    const currentRecord = splatter[activeBinding.mapping];
    const nextRecord = {
      ...currentRecord,
      h: raw[0],
      v: raw[1],
      d: raw[2]
    };

    CK.activeTweak({
      decals: {
        ...decals,
        splatter: {
          ...splatter,
          [activeBinding.mapping]: nextRecord
        }
      }
    });

    // Keep HeroForge's native locator/gizmo visually synchronized with the raw
    // bound Move parameters, but do not dispatch its change listener here:
    // live testing proved that listener drops the locator Z/depth component.
    nativeLocator.position.set(raw[0], raw[1], raw[2]);
    markTransformDirty(nativeLocator);
    try {
      if (typeof nativeTransformer.refresh === 'function') nativeTransformer.refresh();
    } catch (_) {}

    try {
      const colorBake = CK.character && CK.character.display && CK.character.display.colorBake;
      if (colorBake && typeof colorBake.requestRefreshRegular === 'function') colorBake.requestRefreshRegular();
    } catch (_) {}
    try {
      if (CK.GameLoop && typeof CK.GameLoop.requestRenderRefresh === 'function') CK.GameLoop.requestRenderRefresh();
    } catch (_) {}
    try {
      if (CK.Events && typeof CK.Events.emit === 'function') {
        CK.Events.emit('sliderChanged');
        CK.Events.emit('decalSliderChanged');
        if (!finalize) CK.Events.emit('gizmoOnChange');
      }
    } catch (_) {}

    if (finalize) {
      try {
        if (typeof CK.passiveChangeFinish === 'function') CK.passiveChangeFinish();
      } catch (_) {}
      try {
        if (CK.Events && typeof CK.Events.emit === 'function') CK.Events.emit('gizmoAfterChange');
      } catch (_) {}
    }

    lastForward = {
      mode: 'translate',
      finalize,
      position: raw.slice(),
      scale: vec3Array(nativeLocator.scale),
      quaternion: quatArray(nativeLocator.quaternion),
      at: Date.now()
    };
  }

  function computeScreenJacobian(worldPoint, cameraInfo) {
    const base = worldToScreen(worldPoint, cameraInfo);
    if (!base || base.behind) return null;
    const columns = [];
    for (let axis = 0; axis < 3; axis += 1) {
      const probe = worldPoint.slice();
      probe[axis] += SCREEN_JACOBIAN_EPS;
      const projected = worldToScreen(probe, cameraInfo);
      if (!projected || projected.behind) return null;
      columns.push([
        (projected.x - base.x) / SCREEN_JACOBIAN_EPS,
        (projected.y - base.y) / SCREEN_JACOBIAN_EPS
      ]);
    }
    return { base, columns };
  }

  function screenDeltaToMinimumWorldDelta(dx, dy, jacobian) {
    const [c0, c1, c2] = jacobian.columns;
    const a00 = c0[0] * c0[0] + c1[0] * c1[0] + c2[0] * c2[0];
    const a01 = c0[0] * c0[1] + c1[0] * c1[1] + c2[0] * c2[1];
    const a11 = c0[1] * c0[1] + c1[1] * c1[1] + c2[1] * c2[1];
    const det = a00 * a11 - a01 * a01;
    if (!Number.isFinite(det) || Math.abs(det) < 1e-9) return null;
    const y0 = (a11 * dx - a01 * dy) / det;
    const y1 = (-a01 * dx + a00 * dy) / det;
    return [
      c0[0] * y0 + c0[1] * y1,
      c1[0] * y0 + c1[1] * y1,
      c2[0] * y0 + c2[1] * y1
    ];
  }

  function frameVector(frame, vector) {
    if (!frame || !vector) return null;
    const out = mat4MulVec4(frame, [vector[0], vector[1], vector[2], 0]);
    const v = out.slice(0, 3);
    return v.every(Number.isFinite) ? v : null;
  }

  function normalize3(vector) {
    if (!vector) return null;
    const length = Math.hypot(vector[0], vector[1], vector[2]);
    if (!Number.isFinite(length) || length < 1e-9) return null;
    return [vector[0] / length, vector[1] / length, vector[2] / length];
  }

  function axisScreenInfo(axisIndex, worldPoint, cameraInfo, worldFrame) {
    const basis = [[1,0,0],[0,1,0],[0,0,1]][axisIndex];
    const worldBasis = normalize3(frameVector(worldFrame, basis));
    if (!worldBasis) return null;
    const base = worldToScreen(worldPoint, cameraInfo);
    if (!base || base.behind) return null;
    const probe = [
      worldPoint[0] + worldBasis[0] * SCREEN_JACOBIAN_EPS,
      worldPoint[1] + worldBasis[1] * SCREEN_JACOBIAN_EPS,
      worldPoint[2] + worldBasis[2] * SCREEN_JACOBIAN_EPS
    ];
    const projected = worldToScreen(probe, cameraInfo);
    if (!projected || projected.behind) return null;
    const column = [
      (projected.x - base.x) / SCREEN_JACOBIAN_EPS,
      (projected.y - base.y) / SCREEN_JACOBIAN_EPS
    ];
    const mag = Math.hypot(column[0], column[1]);
    if (Number.isFinite(mag) && mag >= 8) {
      return { unit: [column[0] / mag, column[1] / mag], pxPerWorld: mag, worldBasis, fallback: false };
    }
    const fallbackDirections = [[1, 0], [0, -1], [-Math.SQRT1_2, Math.SQRT1_2]];
    return { unit: fallbackDirections[axisIndex], pxPerWorld: FALLBACK_AXIS_PX_PER_WORLD, worldBasis, fallback: true };
  }

  function worldDeltaToRawDelta(worldDelta, worldFrame) {
    const inverse = invertMat4(worldFrame);
    if (!inverse) return null;
    const canonical4 = mat4MulVec4(inverse, [worldDelta[0], worldDelta[1], worldDelta[2], 0]);
    const canonical = canonical4.slice(0, 3);
    if (!canonical.every(Number.isFinite)) return null;
    return [
      canonical[0] / TRANSLATE_AXIS_SCALE.x,
      canonical[1] / TRANSLATE_AXIS_SCALE.y,
      canonical[2] / TRANSLATE_AXIS_SCALE.z
    ];
  }

  function setOrbitEnabled(value) {
    try {
      const CK = getCK();
      if (CK && CK.orbitCamera && CK.orbitCamera.controls) CK.orbitCamera.controls.enabled = value;
    } catch (_) {}
  }

  function beginMoveDrag(event, axisIndex = null) {
    if (event.button !== 0 || activeMoveDrag || !enabled || mode !== 'translate') return;
    try {
      verifyLiveBinding();
      const current = resolveCurrent();
      if (!current.ok) throw new Error(current.reason);
      const cameraInfo = getCameraInfo(current.CK);
      if (!cameraInfo) throw new Error('Camera matrices unavailable.');
      const jacobian = computeScreenJacobian(current.footprint.point, cameraInfo);
      if (!jacobian) throw new Error('Could not compute camera/world Move mapping.');
      const axisInfo = axisIndex == null ? null : axisScreenInfo(axisIndex, current.footprint.point, cameraInfo, current.projector.worldFrame);
      if (axisIndex != null && !axisInfo) throw new Error('Could not compute selected Move axis mapping.');

      activeMoveDrag = {
        pointerId: event.pointerId,
        axisIndex,
        axisInfo,
        startX: event.clientX,
        startY: event.clientY,
        startRaw: [
          num(current.selected.record.h, 0),
          num(current.selected.record.v, 0),
          num(current.selected.record.d, 0)
        ],
        currentRaw: null,
        startAnchorScreen: [current.footprint.screen.x, current.footprint.screen.y],
        jacobian,
        worldFrame: current.projector.worldFrame,
        captureTarget: event.currentTarget,
        predictedScreen: [current.footprint.screen.x, current.footprint.screen.y]
      };
      setOrbitEnabled(false);
      try { event.currentTarget.setPointerCapture(event.pointerId); } catch (_) {}
      setStatus(axisIndex == null ? 'Moving decal in camera plane…' : `Moving ${['H','V','D'][axisIndex]} axis${axisInfo.fallback ? ' (depth fallback)' : ''}…`);
      event.preventDefault();
      event.stopPropagation();
    } catch (error) {
      setStatus(`Move start blocked: ${error && error.message ? error.message : error}`, true);
    }
  }
